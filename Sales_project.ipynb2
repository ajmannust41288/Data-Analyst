          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Grouped Z-Score calculation per product category\n",
        "def calc_zscore(group):\n",
        "    std = group.std()\n",
        "    if std == 0:\n",
        "        return pd.Series(0, index=group.index)\n",
        "    return (group - group.mean()) / std\n",
        "\n",
        "sales['z_score'] = sales.groupby('product_id')['total_amount'].transform(calc_zscore)\n",
        "\n",
        "# Flag transactions with |Z| > 3\n",
        "unusual_txns = sales[sales['z_score'].abs() > 3].sort_values(by='total_amount', ascending=False)\n",
        "\n",
        "print(f\"Total Unusual Transactions Flagged: {len(unusual_txns):,}\")\n",
        "print(\"\\nTop 5 Extreme Outliers:\")\n",
        "print(unusual_txns[['transaction_id', 'customer_id', 'product_id', 'quantity', 'total_amount', 'z_score']].head())"
      ],
      "metadata": {
        "id": "IkGUS5YvTv5d",
        "outputId": "38b89b08-0117-45df-9f29-e55ae7fe9c47",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 41,
      "outputs": [

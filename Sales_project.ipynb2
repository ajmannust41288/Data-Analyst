    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Set random seed for reproducibility\n",
        "np.random.seed(42)\n",
        "num_sales = 500000\n",
        "num_customers = 50000\n",
        "\n",
        "print(\"Generating Customer Directory...\")\n",
        "# 1. Customer Master Table\n",
        "customer_ids = [f\"CUST-{i:05d}\" for i in range(1, num_customers + 1)]\n",
        "customer_names = [f\"Customer_{i}\" for i in range(1, num_customers + 1)]\n",
        "customers_df = pd.DataFrame(\n",
        "    {\"customer_id\": customer_ids, \"customer_name\": customer_names}\n",
        ")\n",
        "\n",
        "# 2. Product Catalog\n",
        "products = {\n",
        "    \"PROD-001\": {\"name\": \"Wireless Mouse\", \"base_price\": 25.0},\n",
        "    \"PROD-002\": {\"name\": \"Mechanical Keyboard\", \"base_price\": 80.0},\n",
        "    \"PROD-003\": {\"name\": \"27-inch Monitor\", \"base_price\": 300.0},\n",
        "    \"PROD-004\": {\"name\": \"USB-C Docking Station\", \"base_price\": 150.0},\n",
        "    \"PROD-005\": {\"name\": \"Ergonomic Chair\", \"base_price\": 250.0},\n",
        "    \"PROD-006\": {\"name\": \"Laptop Stand\", \"base_price\": 45.0},\n",
        "    \"PROD-007\": {\"name\": \"Noise Cancelling Headphones\", \"base_price\": 200.0},\n",
        "}\n",
        "product_keys = list(products.keys())\n",
        "\n",
        "print(\"Generating 500,000 Sales Transactions...\")\n",
        "# Assign sales to 85% of customers (~15% remain inactive)\n",
        "active_customers = customer_ids[: int(num_customers * 0.85)]\n",
        "sales_customer_ids = np.random.choice(active_customers, size=num_sales)\n",
        "sales_product_ids = np.random.choice(product_keys, size=num_sales)\n",
        "quantities = np.random.randint(1, 10, size=num_sales)\n",
        "\n",
        "start_date = pd.Timestamp(\"2025-01-01\")\n",
        "random_days = np.random.randint(0, 600, size=num_sales)\n",
        "sales_dates = start_date + pd.to_timedelta(random_days, unit=\"D\")\n",
        "\n",
        "prices = np.array([products[p][\"base_price\"] for p in sales_product_ids])\n",
        "amounts = quantities * prices + np.random.normal(0, 2, size=num_sales).round(2)\n",
        "\n",
        "sales_df = pd.DataFrame(\n",
        "    {\n",
        "        \"transaction_id\": [f\"TXN-{i:07d}\" for i in range(1, num_sales + 1)],\n",
        "        \"customer_id\": sales_customer_ids,\n",
        "        \"product_id\": sales_product_ids,\n",
        "        \"quantity\": quantities,\n",
        "        \"unit_price\": prices,\n",
        "        \"total_amount\": amounts,\n",
        "        \"sale_date\": sales_dates.strftime(\"%Y-%m-%d\"),\n",
        "    }\n",
        ")\n",
        "\n",
        "print(\"Injecting Data Anomalies & Edge Cases...\")\n",
        "# A) Inject Outliers (100 high-value transactions)\n",
        "anomaly_indices = np.random.choice(sales_df.index, size=100, replace=False)\n",
        "sales_df.loc[anomaly_indices, \"total_amount\"] = np.random.uniform(\n",
        "    15000, 50000, size=100\n",
        ").round(2)\n",
        "sales_df.loc[anomaly_indices, \"quantity\"] = np.random.randint(\n",
        "    150, 500, size=100\n",
        ")\n",
        "\n",
        "# B) Inject Missing Values (NULLs)\n",
        "null_indices = np.random.choice(sales_df.index, size=2500, replace=False)\n",
        "sales_df.loc[null_indices, \"unit_price\"] = np.nan\n",
        "sales_df.loc[null_indices, \"total_amount\"] = np.nan\n",
        "\n",
        "# C) Inject Duplicate Rows\n",
        "duplicates = sales_df.sample(n=1000, random_state=42)\n",
        "sales_df = pd.concat([sales_df, duplicates], ignore_index=True)\n",
        "\n",
        "# D) Inject Trailing Whitespace in product IDs\n",
        "sales_df[\"product_id\"] = sales_df[\"product_id\"].astype(str)\n",
        "whitespace_idx = np.random.choice(sales_df.index, size=3000, replace=False)\n",
        "sales_df.loc[whitespace_idx, \"product_id\"] = (\n",
        "    sales_df.loc[whitespace_idx, \"product_id\"] + \" \"\n",
        ")\n",
        "\n",
        "print(\"Exporting CSV files...\")\n",
        "sales_df.to_csv(\"sales_500k.csv\", index=False)\n",
        "customers_df.to_csv(\"customers.csv\", index=False)\n",
        "\n",
        "print(\"Done! 'sales_500k.csv' and 'customers.csv' created in your working directory.\")"
      ],
      "metadata": {
        "id": "qX1sEfO8NFy_",
        "outputId": "efdf4323-e4a0-44ff-f928-fa7ca5e0f60d",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Generating Customer Directory...\n",
            "Generating 500,000 Sales Transactions...\n",
            "Injecting Data Anomalies & Edge Cases...\n",
            "Exporting CSV files...\n",
            "Done! 'sales_500k.csv' and 'customers.csv' created in your working directory.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Load CSV files uploaded in sample_data / root directory\n",
        "customers = pd.read_csv('customers.csv')\n",
        "sales = pd.read_csv('sales_500k.csv')\n",
        "\n",
        "print(\"=== DATA LOADED SUCCESSFULLY ===\")\n",
        "print(f\"Customers Shape : {customers.shape[0]:,} rows, {customers.shape[1]} columns\")\n",
        "print(f\"Sales Shape     : {sales.shape[0]:,} rows, {sales.shape[1]} columns\")"
      ],
      "metadata": {
        "id": "h1FX6whONsHM",
        "outputId": "c1c66dfd-e69b-4b26-c353-6c2c09d3dba5",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 18,
      "outputs": [

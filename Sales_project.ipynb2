    },
    {
      "cell_type": "code",
      "source": [
        "# missing values in customers\n",
        "print(customers.isnull().sum())"
      ],
      "metadata": {
        "id": "b4BT6v9qPZLd",
        "outputId": "ea8edbbe-46fc-4797-9f0f-582bbf45aa1d",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 27,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "customer_id      0\n",
            "customer_name    0\n",
            "dtype: int64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Clean whitespace from ID columns\n",
        "customers['customer_id'] = customers['customer_id'].astype(str).str.strip()\n",
        "sales['customer_id'] = sales['customer_id'].astype(str).str.strip()\n",
        "sales['product_id'] = sales['product_id'].astype(str).str.strip()"
      ],
      "metadata": {
        "id": "wEsKS8JBP3Fi"
      },
      "execution_count": 28,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 2. Drop duplicate transaction records\n",
        "initial_len = len(sales)\n",
        "sales = sales.drop_duplicates(subset=['transaction_id'])\n",
        "print( \"=====================\")\n",
        "print(f\"Removed {initial_len - len(sales):,} duplicate records.\")"
      ],
      "metadata": {
        "id": "AN6krkAfQpBk",
        "outputId": "8a2b642a-6423-4cce-b2e4-533b68c0ad59",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 32,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "=====================\n",
            "Removed 0 duplicate records.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# handling missing values in total amount\n",
        "sales=sales.dropna(subset=['total_amount'])"
      ],
      "metadata": {
        "id": "RQW1ULdMRs2B"
      },
      "execution_count": 34,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# handling missing values in unit_price\n",
        "sales=sales.dropna(subset=['unit_price'])"
      ],
      "metadata": {
        "id": "6DDcHlEySJyr"
      },
      "execution_count": 35,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 4. Convert date column to datetime object\n",
        "sales['sale_date'] = pd.to_datetime(sales['sale_date'])"
      ],
      "metadata": {
        "id": "iA1v6W0iSW9k"
      },
      "execution_count": 36,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(f\"Cleaned Sales Records: {len(sales):,}\")"
      ],
      "metadata": {
        "id": "r1n4m_hFSc7D",
        "outputId": "1a7994f4-1521-47e4-bdde-80e4c15bf062",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 37,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Cleaned Sales Records: 497,500\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Perform Left Join to find non-purchasing customers\n",
        "customer_sales = customers.merge(sales, on='customer_id', how='left')"
      ],
      "metadata": {
        "id": "8HPvbZ2eS4oo"
      },
      "execution_count": 38,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Filter where transaction_id is NaN\n",
        "inactive_customers = customer_sales[customer_sales['transaction_id'].isna()][['customer_id', 'customer_name']].drop_duplicates()\n",
        "\n",
        "print(f\"Total Inactive Customers: {len(inactive_customers):,} / {len(customers):,}\")\n",
        "print(\"\\nSample Inactive Customers:\")\n",
        "print(inactive_customers.head())"
      ],
      "metadata": {
        "id": "OxDEykLCTAA9",
        "outputId": "1325f9ad-2bc1-43e6-c2f5-9662ed93ef1c",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 39,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Total Inactive Customers: 7,500 / 50,000\n",
            "\n",
            "Sample Inactive Customers:\n",
            "       customer_id   customer_name\n",
            "497500  CUST-42501  Customer_42501\n",
            "497501  CUST-42502  Customer_42502\n",
            "497502  CUST-42503  Customer_42503\n",
            "497503  CUST-42504  Customer_42504\n",
            "497504  CUST-42505  Customer_42505\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "product_summary = sales.groupby('product_id').agg(\n",
        "    total_quantity=('quantity', 'sum'),\n",
        "    total_revenue=('total_amount', 'sum'),\n",
        "    transaction_count=('transaction_id', 'count'),\n",
        "    avg_order_value=('total_amount', 'mean')\n",
        ").reset_index().sort_values(by='total_revenue', ascending=False)\n",
        "\n",
        "product_summary['total_revenue'] = product_summary['total_revenue'].round(2)\n",
        "product_summary['avg_order_value'] = product_summary['avg_order_value'].round(2)\n",
        "\n",
        "print(\"--- Product Performance Breakdown ---\")\n",
        "print(product_summary)"
      ],
      "metadata": {
        "id": "YlDWqE83TYB2",
        "outputId": "e63a4dc6-41be-4f72-a0a3-a8c931003887",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 40,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "--- Product Performance Breakdown ---\n",
            "  product_id  total_quantity  total_revenue  transaction_count  \\\n",
            "2   PROD-003          358229   1.068605e+08              71070   \n",
            "4   PROD-005          358828   8.934660e+07              71285   \n",
            "6   PROD-007          358840   7.138668e+07              71081   \n",
            "3   PROD-004          359994   5.387944e+07              71291   \n",
            "1   PROD-002          358376   2.882713e+07              70775   \n",
            "5   PROD-006          361797   1.665534e+07              70913   \n",
            "0   PROD-001          361977   9.616251e+06              71085   \n",
            "\n",

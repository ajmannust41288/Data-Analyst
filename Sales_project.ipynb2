    {
      "cell_type": "code",
      "source": [
        "inactive_customers.to_csv('inactive_customers_report.csv', index=False)\n",
        "product_summary.to_csv('product_sales_summary.csv', index=False)\n",
        "unusual_txns.to_csv('flagged_unusual_transactions.csv', index=False)\n",
        "sales.to_csv('cleaned_sales_data.csv', index=False)\n",
        "\n",
        "print(\"All reports successfully generated and saved to your Colab directory!\")"
      ],

            "0    Amit   79.166667  Second Class\n",
            "1   Rahul   87.000000   First Class\n",
            "2   Priya   92.000000   Distinction\n",
            "3    Neha   69.500000          Pass\n",
            "4   Arjun   86.000000   First Class\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "numbers = [3, 6, 9, 2, 5]\n",
        "total = 0\n",
        "for num in numbers:\n",
        "    if num > 5:\n",
        "        total += num\n",
        "\n",
        "average = total / len(numbers)\n",
        "if average > 2:\n",
        "    result = \"Greater\"\n",
        "else:\n",
        "    result = \"Smaller\"\n",
        "\n",
        "print(result)"
      ],
      "metadata": {

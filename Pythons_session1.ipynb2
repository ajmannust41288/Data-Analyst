        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Create data using a dictionary\n",
        "data = {\n",
        "    \"Student\": [\"Amit\", \"Rahul\", \"Priya\", \"Neha\", \"Arjun\"],\n",
        "    \"Math\": [78, 85, 92, 65, 88],\n",
        "    \"Python\": [82, 91, 95, 72, 84],\n",
        "    \"C++\": [75, 88, 90, 68, 86],\n",
        "    \"SQL\": [75, 88, 90, 68, 86],\n",
        "    \"English\": [80, 76, 89, 74, 82],\n",
        "    \"Computer\": [85, 94, 96, 70, 90]\n",
        "}\n",
        "\n",
        "# Create a DataFrame\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Print the DataFrame\n",
        "print(df)"
      ],
      "metadata": {
        "id": "BuusQjx6YIPO",
        "outputId": "4a3026f1-6b99-49af-c6f1-28908106e633",
        "colab": {

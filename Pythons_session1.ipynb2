    },
    {
      "cell_type": "code",
      "source": [
        "# Assign Grade based on Percentage\n",
        "def assign_grade(pct):\n",
        "    if pct >= 90:\n",
        "        return \"Distinction\"\n",
        "    elif pct >= 80:\n",
        "        return \"First Class\"\n",
        "    elif pct >= 70:\n",
        "        return \"Second Class\"\n",
        "    else:\n",
        "        return \"Pass\"\n",
        "\n",
        "df[\"Grade\"] = df[\"Percentage\"].apply(assign_grade)\n",
        "print(df[[\"Student\", \"Percentage\", \"Grade\"]])"
      ],
      "metadata": {
        "id": "MJSfaBx4csxM",
        "outputId": "0b7e3865-80eb-467a-c82f-4e947cd3934a",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }

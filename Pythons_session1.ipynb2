        "\n",
        "# Create a new column for Average Percentage\n",
        "df[\"Percentage\"] = df[\"Total_Marks\"] / 6\n",
        "\n",
        "print(df[[\"Student\", \"Total_Marks\", \"Percentage\"]])"
      ],

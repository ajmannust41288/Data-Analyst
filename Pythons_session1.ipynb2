    {
      "cell_type": "code",
      "source": [
        "numbers = [2, 4, 6, 8, 10]\n",
        "total = 0\n",
        "for num in numbers:\n",
        "    if num > 6:\n",
        "        total += num\n",
        "\n",
        "average = total / len(numbers)\n",
        "if average > 3.5:\n",
        "    result = \"High Score\"\n",
        "else:\n",
        "    result = \"Low Score\"\n",
        "\n",
        "print(result)"
      ],
